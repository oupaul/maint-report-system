<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% if (typeof refreshSeconds !== 'undefined' && refreshSeconds) { %><meta http-equiv="refresh" content="<%= refreshSeconds %>"><% } %>
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%= siteName %></title>
  <%- include('partials/head-icons') %>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<div class="app-shell">
  <nav class="app-nav">
    <a href="/" class="app-nav__brand"><%= siteName %></a>
    <div class="app-nav__links">
      <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>">儀表板</a>
      <a href="/batches" class="<%= currentPath && currentPath.startsWith('/batches') ? 'is-active' : '' %>">巡檢批次</a>
      <a href="/assets" class="<%= currentPath && currentPath.startsWith('/assets') ? 'is-active' : '' %>">資產管理</a>
      <% if (currentUser) {
        const isAdmin = currentUser.role === 'admin';
        // 每個項目只在使用者真的有權限進去時才列出（管理員全部都有；技術人員看所屬群組的權限）
        // 「系統管理」選單只給管理員；被群組授權管理設備類型／資產欄位的技術人員看到的是獨立的「設備設定」選單，
        // 不會看到系統管理（使用者、備份、Email…）的字樣，也不會有那些連結
        const adminLinks = [
          ['/users', '使用者管理', isAdmin],
          ['/admin/groups', '權限群組', isAdmin],
          ['/admin/approval', '簽核流程', isAdmin],
          ['/admin/mail', 'Email 通知', isAdmin],
          ['/admin/announcements', '系統通知', isAdmin],
          ['/admin/categories', '設備類型', can('categories.manage')],
          ['/admin/fields', '資產欄位', can('categories.manage')],
          ['/admin/status', '系統狀態', isAdmin],
          ['/admin/backups', '備份管理', isAdmin],
          ['/admin/branding', '外觀設定', isAdmin],
        ].filter(([, , visible]) => visible);
        const adminActive = adminLinks.some(([href]) => currentPath && currentPath.startsWith(href));
        const menuTitle = isAdmin ? '系統管理' : '設備設定';
      %>
        <% if (adminLinks.length > 0) { %>
        <%# 管理功能收進「系統管理」選單（純 HTML <details>，不需要 JavaScript 就能開合；nav-menu.js 只負責點外面/按 Esc 時收起來） %>
        <details class="nav-menu">
          <summary class="<%= adminActive ? 'is-active' : '' %>"><%= menuTitle %></summary>
          <div class="nav-menu__panel">
            <% adminLinks.forEach(([href, label]) => { %>
              <a href="<%= href %>" class="<%= currentPath && currentPath.startsWith(href) ? 'is-active' : '' %>"><%= label %></a>
            <% }) %>
          </div>
        </details>
        <% } %>
      <% } %>
    </div>
    <div class="app-nav__user">
      <% if (currentUser) { %>
        <details class="notif-menu">
          <summary>通知<span class="notif-badge" id="notif-badge" <%= unreadNotifications > 0 ? '' : 'hidden' %>><%= unreadNotifications %></span></summary>
          <div class="notif-panel">
            <% if (recentNotifications.length === 0) { %>
              <div class="notif-empty">目前沒有通知</div>
            <% } else { %>
              <% recentNotifications.forEach(n => { %>
                <form method="POST" action="/notifications/<%= n.id %>/open">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="notif-item <%= n.is_read ? '' : 'is-unread' %>">
                    <strong><%= n.title %></strong>
                    <span><%= n.message.length > 70 ? n.message.slice(0, 70) + '…' : n.message %></span>
                    <time><%= n.created_at.slice(0, 16) %></time>
                  </button>
                </form>
              <% }) %>
            <% } %>
            <div class="notif-footer">
              <a href="/notifications">全部通知</a>
              <% if (unreadNotifications > 0) { %>
                <form method="POST" action="/notifications/read-all" style="margin:0;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="notif-link">全部標為已讀</button>
                </form>
              <% } %>
            </div>
          </div>
        </details>
        <span><%= currentUser.display_name || currentUser.username %>（<%= currentUser.role === 'admin' ? '管理員' : '技術人員' %>）</span>
        <a href="/account/password" class="app-nav__user-link">變更密碼</a>
        <form method="POST" action="/logout" style="margin:0;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn--sm btn--secondary" style="border-color: rgba(255,255,255,0.35); color:#F1F5F9;">登出</button>
        </form>
      <% } %>
    </div>
  </nav>
  <%# 系統通知橫幅：管理員發送的限時訊息（例如「系統即將更新」），到期或被撤回就消失；使用者可以按「知道了」收起來（記在瀏覽器裡） %>
  <% if (currentUser) { %>
    <div class="announcements" id="announcements" aria-live="polite">
      <% (typeof activeAnnouncements !== 'undefined' ? activeAnnouncements : []).forEach(a => { %>
        <div class="announcement announcement--<%= a.level %>" data-id="<%= a.id %>" role="status">
          <span class="announcement__tag"><%= a.level === 'warning' ? '重要' : '系統通知' %></span>
          <span class="announcement__text"><%= a.message %></span>
          <time class="announcement__time"><%= a.at %> 發布</time>
          <button type="button" class="announcement__close">知道了</button>
        </div>
      <% }) %>
    </div>
  <% } %>
  <main class="app-main">

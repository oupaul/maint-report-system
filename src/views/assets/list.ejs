<%- include('../layout', { title: '資產管理' }) %>

<%
  // 欄位標題可點擊排序（再點一次反向）；目前排序的欄位顯示箭頭
  const sortHead = (key, label) => {
    const active = params.sort === key;
    const next = active && params.dir === 'asc' ? 'desc' : 'asc';
    return `<a href="${link({ sort: key, dir: next, page: 1 })}" class="sort-link${active ? ' is-active' : ''}" title="依${label}排序">${label}${active ? (params.dir === 'asc' ? ' ▲' : ' ▼') : ''}</a>`;
  };
  const filtered = !!(params.q || params.category || params.location || params.status || params.tag || params.customer);
  const manage = can('assets.manage');
  // 可顯示／隱藏的欄位（名稱、勾選、編輯固定顯示）；on＝預設顯示，使用者的選擇記在瀏覽器（localStorage）
  const colDefs = [
    { key: 'customer', label: '客戶', on: true },
    ...(params.grouped ? [] : [{ key: 'category', label: '類別', on: true }]),
    { key: 'location', label: '位置', on: true },
    { key: 'ip', label: 'IP / MAC', on: true },
    { key: 'hostname', label: '主機名稱', on: false },
    { key: 'brand', label: '廠牌 / 型號', on: false },
    { key: 'serial', label: '序號', on: false },
    { key: 'asset_tag', label: '財產編號', on: false },
    { key: 'purchase', label: '購置日期', on: false },
    ...listFields.map(f => ({ key: 'cf' + f.id, label: f.label, on: false })),
    { key: 'tags', label: '標籤', on: false },
    { key: 'status', label: '狀態', on: true },
  ];
  const colCount = 1 + colDefs.length + (manage ? 2 : 0);
%>

<div class="page-header">
  <h1>資產管理</h1>
  <div class="page-actions">
    <% if (can('assets.manage')) { %>
      <a href="/assets/new" class="btn btn--primary btn--md">新增資產</a>
    <% } %>
    <a href="<%= exportUrl %>" class="btn btn--secondary btn--md" title="匯出目前篩選條件下的全部設備（不分頁）">匯出 CSV</a>
    <% if (can('assets.manage')) { %><a href="/assets/import" class="btn btn--secondary btn--md">匯入 CSV</a><% } %>
    <a href="/capacity" class="btn btn--secondary btn--md">容量預警</a>
  </div>
</div>

<% if (flash) { %><div class="form-success"><%= flash %></div><% } %>
<div class="card">
  <% if (totalAll > 0) { %>
    <form method="GET" action="/assets" class="asset-filter" id="asset-filter" role="search">
      <input type="search" class="form-input" name="q" value="<%= params.q %>" placeholder="搜尋名稱、位置、IP、序號、標籤…（可輸入多個關鍵字）" title="可搜尋：名稱、位置、IP、MAC、主機名稱、廠牌、型號、序號、財產編號、購置日期、標籤、自訂欄位" aria-label="搜尋資產" autocomplete="off">
      <select class="form-select" name="category" aria-label="依類別篩選">
        <option value="">全部類別</option>
        <% categoryOrder.forEach(code => { %>
          <option value="<%= code %>" <%= params.category === code ? 'selected' : '' %>><%= categoryLabels[code] %></option>
        <% }) %>
      </select>
      <% if (customerList.length > 0) { %>
        <select class="form-select" name="customer" aria-label="依客戶篩選" data-searchable>
          <option value="">全部客戶</option>
          <option value="none" <%= params.customer === 'none' ? 'selected' : '' %>>未指定客戶（<%= unassignedCount %>）</option>
          <% customerList.forEach(c => { %><option value="<%= c.id %>" data-search="<%= [c.tax_id, c.code].filter(Boolean).join(' ') %>" <%= params.customer === String(c.id) ? 'selected' : '' %>><%= c.name %>（<%= c.asset_count %>）<%= c.is_active ? '' : '・已停用' %></option><% }) %>
        </select>
      <% } %>
      <select class="form-select" name="location" aria-label="依位置篩選">
        <option value="">全部位置</option>
        <% locations.forEach(l => { %><option value="<%= l %>" <%= params.location === l ? 'selected' : '' %>><%= l %></option><% }) %>
      </select>
      <select class="form-select" name="status" aria-label="依狀態篩選">
        <option value="">全部狀態</option>
        <option value="1" <%= params.status === '1' ? 'selected' : '' %>>啟用中</option>
        <option value="0" <%= params.status === '0' ? 'selected' : '' %>>已停用</option>
      </select>
      <% if (tagList.length > 0) { %>
        <select class="form-select" name="tag" aria-label="依標籤篩選">
          <option value="">全部標籤</option>
          <% tagList.forEach(t => { %><option value="<%= t.name %>" <%= params.tag === t.name ? 'selected' : '' %>><%= t.name %>（<%= t.count %>）</option><% }) %>
        </select>
      <% } %>
      <input type="hidden" name="group" value="<%= params.grouped ? '1' : '0' %>">
      <input type="hidden" name="sort" value="<%= params.sort %>">
      <input type="hidden" name="dir" value="<%= params.dir %>">
      <input type="hidden" name="per" value="<%= params.per %>">
      <button type="submit" class="btn btn--secondary btn--md">搜尋</button>
      <% if (filtered) { %><a href="<%= link({ q: '', category: '', location: '', status: '', tag: '', customer: '', page: 1 }) %>" class="btn btn--secondary btn--md">清除</a><% } %>
    </form>
    <div class="asset-toolbar">
      <span class="form-hint"><%= filtered ? `符合 ${total} / 全部 ${totalAll} 筆` : `共 ${totalAll} 筆` %><%= pages > 1 ? `・第 ${page} / ${pages} 頁` : '' %></span>
      <span class="asset-toolbar__right">
        <% if (params.grouped) { %>
          <button type="button" class="btn btn--secondary btn--sm" id="groups-expand" hidden>全部展開</button>
          <button type="button" class="btn btn--secondary btn--sm" id="groups-collapse" hidden>全部收合</button>
        <% } %>
        <details class="col-chooser" id="col-chooser" hidden>
          <summary class="btn btn--secondary btn--sm">顯示欄位</summary>
          <div class="col-chooser__panel">
            <% colDefs.forEach(c => { %>
              <label class="col-chooser__item"><input type="checkbox" data-col-toggle="<%= c.key %>" data-default="<%= c.on ? '1' : '0' %>"> <%= c.label %></label>
            <% }) %>
            <button type="button" class="btn btn--secondary btn--sm" id="col-reset">恢復預設</button>
          </div>
        </details>
        <a href="<%= link({ group: params.grouped ? '0' : '1', page: 1 }) %>" class="btn btn--secondary btn--sm"><%= params.grouped ? '改成平面列表' : '改成依類別分組' %></a>
        <span class="form-hint">每頁</span>
        <% perOptions.forEach(n => { %>
          <a href="<%= link({ per: n, page: 1 }) %>" class="btn btn--sm <%= params.per === n ? 'btn--primary' : 'btn--secondary' %>"><%= n %></a>
        <% }) %>
      </span>
    </div>
  <% } %>

  <% if (totalAll === 0) { %>
    <div class="empty-state">尚無資產資料。</div>
  <% } else if (total === 0) { %>
    <div class="empty-state">沒有符合條件的資產。</div>
  <% } else { %>
    <% if (manage && customerList.some(c => c.is_active)) { %>
      <div class="bulk-bar" id="bulk-bar">
        <span class="form-hint">批次設定客戶：先勾選下面的設備，</span>
        <select class="form-select" name="customer_id" form="bulk-form" id="bulk-customer" aria-label="要設定的客戶" data-searchable>
          <option value="">（清除客戶＝未指定）</option>
          <% customerList.filter(c => c.is_active).forEach(c => { %><option value="<%= c.id %>" data-search="<%= [c.tax_id, c.code].filter(Boolean).join(' ') %>"><%= c.name %></option><% }) %>
        </select>
        <button type="submit" form="bulk-form" class="btn btn--secondary btn--sm" id="bulk-apply" disabled>套用到已選的 <span id="bulk-count">0</span> 台</button>
        <label class="form-hint"><input type="checkbox" name="scope" value="all" form="bulk-form" id="bulk-all"> 改成套用到「目前篩選條件下的全部 <%= total %> 台」</label>
      </div>
    <% } %>
    <form method="POST" action="/assets/bulk-customer" id="bulk-form" data-confirm="確定要變更這些設備的客戶嗎？">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% ['q', 'category', 'location', 'status', 'tag', 'customer'].forEach(k => { if (params[k]) { %><input type="hidden" name="<%= k %>" value="<%= params[k] %>"><% } }) %>
    <div class="table-wrap">
      <table class="data-table asset-table<%= manage ? ' has-sel' : '' %>">
        <thead>
          <tr>
            <% if (manage) { %><th class="col-sel col-sticky"><input type="checkbox" id="select-all" aria-label="全選本頁"></th><% } %>
            <th class="col-name col-sticky"><%- sortHead('name', '名稱') %></th>
            <th data-col="customer"><%- sortHead('customer', '客戶') %></th>
            <% if (!params.grouped) { %><th data-col="category"><%- sortHead('category', '類別') %></th><% } %>
            <th data-col="location"><%- sortHead('location', '位置') %></th>
            <th data-col="ip"><%- sortHead('ip_address', 'IP') %> / MAC</th>
            <th data-col="hostname"><%- sortHead('hostname', '主機名稱') %></th>
            <th data-col="brand"><%- sortHead('brand', '廠牌 / 型號') %></th>
            <th data-col="serial"><%- sortHead('serial_number', '序號') %></th>
            <th data-col="asset_tag"><%- sortHead('asset_tag', '財產編號') %></th>
            <th data-col="purchase"><%- sortHead('purchase_date', '購置日期') %></th>
            <% listFields.forEach(f => { %><th data-col="cf<%= f.id %>"><%= f.label %></th><% }) %>
            <th data-col="tags">標籤</th>
            <th data-col="status"><%- sortHead('is_active', '狀態') %></th>
            <% if (manage) { %><th class="col-actions col-sticky"></th><% } %>
          </tr>
        </thead>
        <%
          // 依序輸出；分組顯示時每遇到新的類別就先插一列標題（可摺疊），標題顯示該類別符合條件的總台數與本頁台數
          const onPage = {};
          rows.forEach(a => { onPage[a.category] = (onPage[a.category] || 0) + 1; });
          let lastCat = null;
        %>
        <tbody>
          <% rows.forEach(a => { %>
            <% if (params.grouped && a.category !== lastCat) { lastCat = a.category; %>
              <tr class="group-row" data-group="<%= a.category %>">
                <td colspan="<%= colCount %>">
                  <button type="button" class="group-toggle" aria-expanded="true">
                    <span class="group-toggle__icon" aria-hidden="true">▾</span>
                    <strong><%= categoryLabels[a.category] || a.category %></strong>
                    <span class="form-hint">（共 <%= groupCounts[a.category] %> 台<%= onPage[a.category] !== groupCounts[a.category] ? `，本頁 ${onPage[a.category]} 台` : '' %>）</span>
                  </button>
                </td>
              </tr>
            <% } %>
            <tr data-g="<%= a.category %>">
              <% if (manage) { %><td class="col-sel col-sticky"><input type="checkbox" class="row-check" name="ids" value="<%= a.id %>" aria-label="選取 <%= a.name %>"></td><% } %>
              <td class="col-name col-sticky">
                <% if (manage) { %><a href="/assets/<%= a.id %>/edit" class="asset-name" title="編輯 <%= a.name %>"><%= a.name %></a><% } else { %><span class="asset-name"><%= a.name %></span><% } %>
                <% if (capacityAssets.has(a.id)) { %><a href="/capacity/assets/<%= a.id %>" class="tag-chip trend-chip" title="查看 <%= a.name %> 的容量趨勢">容量趨勢</a><% } %>
              </td>
              <td data-col="customer"><%= a.customer_name || '-' %></td>
              <% if (!params.grouped) { %><td data-col="category"><%= categoryLabels[a.category] || a.category %></td><% } %>
              <td data-col="location"><%= a.location || '-' %></td>
              <td data-col="ip"><%= a.ip_address || '-' %><% if (a.mac_address) { %><br><small class="form-hint"><%= a.mac_address %></small><% } %></td>
              <td data-col="hostname"><%= a.hostname || '-' %></td>
              <td data-col="brand"><%= [a.brand, a.model].filter(Boolean).join(' ') || '-' %></td>
              <td data-col="serial"><%= a.serial_number || '-' %></td>
              <td data-col="asset_tag"><%= a.asset_tag || '-' %><% if (a.identifier) { %> <span class="status-badge status-badge--warning" title="舊識別碼尚未整理：<%= a.identifier %>">待整理</span><% } %></td>
              <td data-col="purchase"><%= a.purchase_date || '-' %></td>
              <% listFields.forEach(f => { const cd = a.customDisplay.find(x => x.id === f.id); %><td data-col="cf<%= f.id %>"><%= cd ? cd.text : '-' %></td><% }) %>
              <td data-col="tags">
                <% if (a.tags.length === 0) { %>-<% } %>
                <% a.tags.forEach(t => { %><a class="tag-chip" href="<%= link({ tag: t, page: 1 }) %>" title="只看這個標籤"><%= t %></a> <% }) %>
              </td>
              <td data-col="status">
                <% if (a.is_active) { %>
                  <span class="status-badge status-badge--normal">啟用</span>
                <% } else { %>
                  <span class="status-badge status-badge--critical">停用</span>
                <% } %>
              </td>
              <% if (manage) { %>
                <td class="col-actions col-sticky"><a href="/assets/<%= a.id %>/edit" class="btn btn--secondary btn--sm">編輯</a></td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    </form>

    <% if (pages > 1) {
      // 頁碼：第一頁、最後一頁、目前頁前後各 2 頁，中間用 … 省略
      const nums = [];
      for (let i = 1; i <= pages; i++) { if (i === 1 || i === pages || Math.abs(i - page) <= 2) nums.push(i); }
    %>
      <nav class="pager" aria-label="分頁">
        <% if (page > 1) { %><a class="btn btn--secondary btn--sm" href="<%= link({ page: page - 1 }) %>">上一頁</a><% } %>
        <% nums.forEach((n, i) => { %>
          <% if (i > 0 && n - nums[i - 1] > 1) { %><span class="form-hint">…</span><% } %>
          <% if (n === page) { %><span class="btn btn--primary btn--sm" aria-current="page"><%= n %></span>
          <% } else { %><a class="btn btn--secondary btn--sm" href="<%= link({ page: n }) %>"><%= n %></a><% } %>
        <% }) %>
        <% if (page < pages) { %><a class="btn btn--secondary btn--sm" href="<%= link({ page: page + 1 }) %>">下一頁</a><% } %>
      </nav>
    <% } %>
  <% } %>
</div>

<script src="<%= assetUrl('/js/assets-list.js') %>"></script>
<%- include('../partials/footer') %>

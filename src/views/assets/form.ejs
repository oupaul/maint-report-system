<%- include('../layout', { title: asset && asset.id ? '編輯資產' : '新增資產' }) %>

<div class="page-header">
  <h1><%= asset && asset.id ? '編輯資產' : '新增資產' %></h1>
</div>

<div class="card" style="max-width: 640px;">
  <% if (error) { %>
    <div class="form-error"><%= error %></div>
  <% } %>
  <% if (saved) { %>
    <div class="form-success">已儲存。</div>
  <% } %>
  <% if (warnings && warnings.length > 0) { %>
    <div class="form-warning" role="status">
      <strong>請留意（不影響儲存）：</strong>
      <ul>
        <% warnings.forEach(w => { %><li><%= w %></li><% }) %>
      </ul>
    </div>
  <% } %>
  <form method="POST" action="<%= asset && asset.id ? `/assets/${asset.id}/edit` : '/assets' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <fieldset class="form-section">
    <legend>基本資料</legend>
    <div class="form-group">
      <label class="form-label" for="name">資產名稱</label>
      <input class="form-input" type="text" id="name" name="name" value="<%= asset ? (asset.name || '') : '' %>" required>
    </div>
    <div class="form-group">
      <label class="form-label" for="category">類別</label>
      <% if (categoryLocked) { %>
        <%# 已有檢查紀錄的設備不能改類型（disabled 的欄位不會送出，所以另外帶一個隱藏欄位） %>
        <input type="hidden" name="category" value="<%= asset.category %>">
        <select class="form-select" id="category" disabled>
          <option><%= categoryLabels[asset.category] || asset.category %></option>
        </select>
        <p class="form-hint">這個設備已經有檢查紀錄，不能變更類型（舊紀錄對應的是原本類型的檢查項目）。</p>
      <% } else { %>
      <select class="form-select" id="category" name="category" required>
        <% categories.forEach(c => { %>
          <option value="<%= c %>" <%= asset && asset.category === c ? 'selected' : '' %>><%= categoryLabels[c] %></option>
        <% }) %>
      </select>
      <% } %>
    </div>
    <div class="form-group">
      <label class="form-label" for="customer_id">客戶</label>
      <select class="form-select" id="customer_id" name="customer_id" data-searchable <%= !(asset && asset.id) && customers.length > 0 ? 'required' : '' %>>
        <option value=""><%= asset && asset.id ? '（未指定客戶）' : '請選擇客戶' %></option>
        <% customers.forEach(c => { %><option value="<%= c.id %>" data-search="<%= [c.tax_id, c.code].filter(Boolean).join(' ') %>" <%= asset && Number(asset.customer_id) === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
      <p class="form-hint">這台設備屬於哪一家客戶。巡檢批次可以同時涵蓋多家客戶的設備，報告與清單都會標示每台設備的客戶。<% if (can('assets.manage')) { %>客戶清單在「系統管理 → 客戶」維護。<% } %></p>
    </div>
    <div class="form-group">
      <label class="form-label" for="location">位置</label>
      <input class="form-input" type="text" id="location" name="location" maxlength="100" list="location-list" autocomplete="off" value="<%= asset ? (asset.location || '') : '' %>">
      <datalist id="location-list">
        <% locations.forEach(l => { %><option value="<%= l %>"></option><% }) %>
      </datalist>
      <p class="form-hint">輸入時會列出已經用過的位置，請盡量選同一種寫法，之後才好篩選。</p>
    </div>
    <div class="form-group">
      <label class="form-label" for="tags">標籤</label>
      <input class="form-input" type="text" id="tags" name="tags" maxlength="300" autocomplete="off" value="<%= tagsText %>" placeholder="例如：ERP, 財務部, 重要">
      <p class="form-hint">用逗號分隔，一台設備最多 10 個、每個最多 20 字。標籤可以跨類別、跨位置地分組與篩選（列表、建立巡檢批次時都能用）。</p>
      <% if (tagSuggestions.length > 0) { %>
        <div class="tag-suggest" id="tag-suggest" aria-label="現有標籤，點一下加入或移除">
          <span class="form-hint">現有標籤：</span>
          <% tagSuggestions.forEach(t => { %><button type="button" class="tag-chip" data-tag="<%= t.name %>"><%= t.name %></button><% }) %>
        </div>
      <% } %>
    </div>
    </fieldset>

    <fieldset class="form-section">
    <legend>網路</legend>
    <div class="form-group">
      <label class="form-label" for="ip_address">IP 位址</label>
      <input class="form-input" type="text" id="ip_address" name="ip_address" maxlength="200" value="<%= asset ? (asset.ip_address || '') : '' %>" placeholder="例如 192.168.1.10">
      <p class="form-hint">有多個 IP（例如多張網卡）請用逗號分隔。</p>
    </div>
    <div class="form-group">
      <label class="form-label" for="mac_address">MAC 位址</label>
      <input class="form-input" type="text" id="mac_address" name="mac_address" maxlength="200" value="<%= asset ? (asset.mac_address || '') : '' %>" placeholder="例如 AA:BB:CC:DD:EE:FF">
      <p class="form-hint">分隔符號用 <code>:</code>、<code>-</code> 或不加都可以，存檔時統一整理成大寫加冒號；多個請用逗號分隔。</p>
    </div>
    <div class="form-group">
      <label class="form-label" for="hostname">主機名稱</label>
      <input class="form-input" type="text" id="hostname" name="hostname" maxlength="100" value="<%= asset ? (asset.hostname || '') : '' %>">
    </div>
    </fieldset>

    <fieldset class="form-section">
    <legend>識別與採購</legend>
    <div class="form-group">
      <label class="form-label" for="serial_number">序號</label>
      <input class="form-input" type="text" id="serial_number" name="serial_number" maxlength="100" value="<%= asset ? (asset.serial_number || '') : '' %>">
    </div>
    <div class="form-group">
      <label class="form-label" for="asset_tag">財產編號</label>
      <input class="form-input" type="text" id="asset_tag" name="asset_tag" maxlength="100" value="<%= asset ? (asset.asset_tag || '') : '' %>">
    </div>
    <div class="form-group">
      <label class="form-label" for="brand">廠牌</label>
      <input class="form-input" type="text" id="brand" name="brand" maxlength="100" value="<%= asset ? (asset.brand || '') : '' %>" placeholder="例如 Dell、HPE、Synology">
    </div>
    <div class="form-group">
      <label class="form-label" for="model">型號</label>
      <input class="form-input" type="text" id="model" name="model" maxlength="100" value="<%= asset ? (asset.model || '') : '' %>">
    </div>
    <div class="form-group">
      <label class="form-label" for="purchase_date">購置日期</label>
      <input class="form-input" type="date" id="purchase_date" name="purchase_date" value="<%= asset ? (asset.purchase_date || '') : '' %>">
    </div>
    <% if (asset && asset.identifier) { %>
      <div class="form-group">
        <label class="form-label" for="identifier">舊識別碼（待整理）</label>
        <input class="form-input" type="text" id="identifier" name="identifier" maxlength="200" value="<%= asset.identifier %>">
        <p class="form-hint">這是舊版「識別碼」欄位留下的內容。請把它分到上面對應的欄位，再把這一欄清空；清空儲存後這一欄就不會再出現。</p>
      </div>
    <% } %>
    </fieldset>

    <% const shownCustom = customFields.filter(f => !(categoryLocked && !f.applies)); %>
    <% if (shownCustom.length > 0) { %>
    <fieldset class="form-section" id="custom-section">
    <legend>自訂欄位</legend>
    <% } %>
    <% customFields.forEach(f => {
      // 已有檢查紀錄而鎖定類型時，不適用的欄位直接不顯示；可改類型時全部渲染，由 asset-form.js 依選的類別顯示或隱藏
      if (categoryLocked && !f.applies) return;
      const fid = 'cf_' + f.id; %>
      <div class="form-group cf-field" data-cats="<%= f.categoryList ? f.categoryList.join(',') : '' %>" <%= f.applies ? '' : 'hidden' %>>
        <label class="form-label" for="<%= fid %>"><%= f.label %></label>
        <% if (f.type === 'number') { %>
          <input class="form-input" type="number" step="any" id="<%= fid %>" name="<%= fid %>" value="<%= f.value %>">
        <% } else if (f.type === 'date') { %>
          <input class="form-input" type="date" id="<%= fid %>" name="<%= fid %>" value="<%= f.value %>">
        <% } else if (f.type === 'select') { %>
          <select class="form-select" id="<%= fid %>" name="<%= fid %>">
            <option value="">（未填）</option>
            <% f.optionList.forEach(o => { %><option value="<%= o %>" <%= f.value === o ? 'selected' : '' %>><%= o %></option><% }) %>
            <% if (f.value && !f.optionList.includes(f.value)) { %><option value="<%= f.value %>" selected><%= f.value %>（已不在選項中）</option><% } %>
          </select>
        <% } else if (f.type === 'boolean') { %>
          <select class="form-select" id="<%= fid %>" name="<%= fid %>">
            <option value="">（未填）</option>
            <option value="1" <%= f.value === '1' ? 'selected' : '' %>>是</option>
            <option value="0" <%= f.value === '0' ? 'selected' : '' %>>否</option>
          </select>
        <% } else { %>
          <input class="form-input" type="text" id="<%= fid %>" name="<%= fid %>" maxlength="200" value="<%= f.value %>">
        <% } %>
      </div>
    <% }) %>
    <% if (shownCustom.length > 0) { %></fieldset><% } %>

    <fieldset class="form-section">
    <legend>其他</legend>
    <div class="form-group">
      <label class="form-label" for="notes">備註</label>
      <textarea class="form-textarea" id="notes" name="notes"><%= asset ? (asset.notes || '') : '' %></textarea>
    </div>
    <% if (asset && asset.id) { %>
      <div class="form-group form-checkbox-row">
        <input type="checkbox" id="is_active" name="is_active" <%= asset.is_active ? 'checked' : '' %>>
        <label class="form-label" for="is_active" style="margin:0;">啟用中</label>
      </div>
    <% } %>
    </fieldset>
    <button type="submit" class="btn btn--primary btn--md">儲存</button>
    <a href="/assets" class="btn btn--secondary btn--md">取消</a>
  </form>
</div>

<script src="<%= assetUrl('/js/asset-form.js') %>"></script>
<%- include('../partials/footer') %>

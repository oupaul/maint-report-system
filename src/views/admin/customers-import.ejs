<%- include('../layout', { title: '匯入客戶 CSV' }) %>

<div class="page-header">
  <h1>匯入客戶 CSV</h1>
  <div class="page-actions"><a href="/admin/customers" class="btn btn--secondary btn--md">回到客戶</a></div>
</div>

<% if (error) { %><div class="form-error"><%= error %></div><% } %>

<% if (result) { %>
  <div class="card">
    <div class="form-success">匯入完成：新增 <strong><%= result.created %></strong> 個、更新 <strong><%= result.updated %></strong> 個<%= result.unchanged ? `、無變更 ${result.unchanged} 個` : '' %><%= result.skipped ? `、因錯誤略過 ${result.skipped} 列` : '' %>。</div>
    <a href="/admin/customers" class="btn btn--primary btn--md">回到客戶清單</a>
    <a href="/admin/customers/import" class="btn btn--secondary btn--md">再匯入另一個檔案</a>
  </div>
<% } else if (preview) { %>
  <div class="card">
    <p class="form-hint">檔案：<strong><%= filename %></strong>（編碼：<%= encoding %>）。<strong>下面只是預覽，還沒有寫入任何資料。</strong></p>
    <% if (preview.fileErrors.length > 0) { %>
      <div class="form-error"><strong>這個檔案無法匯入：</strong><ul><% preview.fileErrors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
      <a href="/admin/customers/import" class="btn btn--secondary btn--md">重新選擇檔案</a>
    <% } else { %>
      <% const s = preview.summary; %>
      <div class="import-summary">
        <span class="status-badge status-badge--normal">新增 <%= s.create %></span>
        <span class="status-badge status-badge--warning">更新 <%= s.update %></span>
        <span class="status-badge">無變更 <%= s.unchanged %></span>
        <span class="status-badge status-badge--critical">錯誤（將略過）<%= s.error %></span>
      </div>
      <% if (preview.ignoredColumns.length > 0) { %><p class="form-hint">以下欄位無法對應，已忽略：<%= preview.ignoredColumns.join('、') %></p><% } %>
      <% if (s.clears > 0) { %><div class="form-warning" role="status"><strong>注意：</strong>有 <%= s.clears %> 個欄位原本有資料、但檔案裡的儲存格是空白，匯入後會被<strong>清空</strong>（下方以「→（清空）」標示）。不是你要的話，請先修改檔案，或把那一欄整個刪掉（整欄不存在就完全不動）。</div><% } %>

      <% if (s.create + s.update > 0) { %>
        <form method="POST" action="/admin/customers/import/confirm" data-confirm="確定要匯入嗎？將新增 <%= s.create %> 個、更新 <%= s.update %> 個<%= s.error ? '，另外 ' + s.error + ' 列有錯誤的會略過' : '' %>。">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="token" value="<%= token %>">
          <button type="submit" class="btn btn--primary btn--md">確認匯入（新增 <%= s.create %>、更新 <%= s.update %>）</button>
          <a href="/admin/customers/import" class="btn btn--secondary btn--md">取消，重新選擇檔案</a>
        </form>
      <% } else { %>
        <p class="form-hint">沒有可以匯入的資料。</p>
        <a href="/admin/customers/import" class="btn btn--secondary btn--md">重新選擇檔案</a>
      <% } %>

      <% const label = { create: '新增', update: '更新', unchanged: '無變更', error: '錯誤' }; %>
      <h2 style="margin-top: var(--space-6);">逐列結果</h2>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>列</th><th>結果</th><th>客戶</th><th>內容</th></tr></thead>
          <tbody>
            <% preview.rows.forEach(r => { %>
              <tr>
                <td><%= r.line %></td>
                <td><span class="status-badge <%= r.action === 'create' ? 'status-badge--normal' : (r.action === 'update' ? 'status-badge--warning' : (r.action === 'error' ? 'status-badge--critical' : '')) %>"><%= label[r.action] %></span></td>
                <td><%= r.name || '-' %><% if (r.id) { %> <small class="form-hint">（ID <%= r.id %>）</small><% } %></td>
                <td>
                  <% r.errors.forEach(e => { %><div class="import-err"><%= e %></div><% }) %>
                  <% r.changes.forEach(c => { %><div class="import-change"><strong><%= c.label %></strong>：<%= c.from || '（空）' %> → <%= c.to || '（清空）' %></div><% }) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
<% } else { %>
  <div class="card" style="max-width: 760px;">
    <h2>上傳 CSV</h2>
    <p class="form-hint">建議做法：先「匯出 CSV」或下載空白範本，用 Excel 修改或新增，再回來上傳。上傳後先<strong>預覽</strong>，確認才寫入。</p>
    <form method="POST" action="/admin/customers/import?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
      <div class="form-group">
        <label class="form-label" for="file">CSV 檔案（上限 1MB、<%= maxRows %> 列）</label>
        <input class="form-input" type="file" id="file" name="file" accept=".csv,text/csv" required>
      </div>
      <button type="submit" class="btn btn--primary btn--md">上傳並預覽</button>
      <a href="/admin/customers/import-template.csv" class="btn btn--secondary btn--md">下載空白範本</a>
      <a href="/admin/customers/export.csv" class="btn btn--secondary btn--md">匯出目前全部客戶</a>
    </form>
  </div>
  <div class="card">
    <h2>規則說明</h2>
    <ul class="form-hint import-rules">
      <li><strong>欄位</strong>：客戶ID、客戶名稱、統一編號、簡稱／代碼、備註、狀態（啟用／停用）；「設備數」只是匯出給你看，匯入會忽略。</li>
      <li><strong>新增或更新</strong>：有「客戶ID」就以 ID 為準（<strong>可以改名</strong>）；沒有 ID 就先用「統一編號」、再用「客戶名稱」（不分大小寫）對應——對得到就更新它，對不到就新增（統編和名稱對到不同客戶會當成錯誤）。<strong>「客戶ID」是系統的流水號，不是統編</strong>，要匯入統編請用「統一編號」欄（Excel 把前導 0 吃掉變 7 碼時會自動補回）。</li>
      <li><strong>空白儲存格</strong>：欄位存在但空白＝清空統編／簡稱／備註；整欄不在檔案裡＝完全不動；「狀態」空白＝不動。預覽會標出每個「清空」。</li>
      <li>名稱與統編都不能重複（含檔案裡的重複列）、統編是 8 碼數字、名稱最多 40 字、簡稱最多 20 字、備註最多 300 字；有錯的列會略過，其他列照常匯入。</li>
      <li><strong>匯入不會刪除客戶</strong>；不再使用的客戶請把「狀態」改成「停用」（停用後新增設備不再列出，既有設備與報告不受影響）。</li>
      <li>用 Excel 開啟、存檔時請選「<strong>CSV UTF-8（逗號分隔）</strong>」（舊版「CSV（逗號分隔）」的 Big5 編碼也能自動辨識）。</li>
    </ul>
  </div>
<% } %>

<%- include('../partials/footer') %>

<%- include('../layout', { title: group ? '編輯群組：' + group.name : '新增群組' }) %>

<div class="page-header">
  <h1><%= group ? group.name : '新增群組' %></h1>
  <div class="page-actions">
    <a href="/admin/groups" class="btn btn--secondary btn--md">回到權限群組</a>
  </div>
</div>

<% if (ok) { %><div class="form-success"><%= ok %></div><% } %>
<% if (error) { %><div class="form-error"><%= error %></div><% } %>

<div class="card" style="max-width: 640px;">
  <form method="POST" action="<%= group ? '/admin/groups/' + group.id : '/admin/groups' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label class="form-label" for="name">群組名稱</label>
      <input class="form-input" type="text" id="name" name="name" maxlength="<%= maxName %>" value="<%= form.name %>" placeholder="例如：設備管理員" required>
    </div>
    <div class="form-group">
      <label class="form-label" for="description">說明（選填）</label>
      <input class="form-input" type="text" id="description" name="description" maxlength="<%= maxDesc %>" value="<%= form.description %>">
    </div>
    <div class="form-group">
      <label class="form-label">這個群組的成員可以…</label>
      <% permissions.forEach(p => { %>
        <label class="form-checkbox-row" style="align-items: flex-start; margin-bottom: var(--space-2);">
          <input type="checkbox" name="permissions" value="<%= p.key %>" <%= form.permissions.includes(p.key) ? 'checked' : '' %>>
          <span><strong><%= p.label %></strong><br><span class="form-hint"><%= p.description %></span></span>
        </label>
      <% }) %>
    </div>
    <button type="submit" class="btn btn--primary btn--md">儲存</button>
  </form>

  <% if (group) { %>
    <hr style="border: none; border-top: 1px solid var(--color-border); margin: var(--space-6) 0;">
    <h2>成員（<%= members.length %> 人）</h2>
    <% if (members.length === 0) { %>
      <p class="form-hint">還沒有成員。到「使用者管理」編輯使用者，在「權限群組」欄位選這個群組即可加入。</p>
    <% } else { %>
      <ul class="plain-list">
        <% members.forEach(m => { %>
          <li><a href="/users/<%= m.id %>/edit"><%= m.display_name || m.username %></a>
            <span class="form-hint">（<%= m.username %><%= m.is_active ? '' : '・已停用' %><%= m.role === 'admin' ? '・管理員' : '' %>）</span></li>
        <% }) %>
      </ul>
    <% } %>
    <form method="POST" action="/admin/groups/<%= group.id %>/delete" data-confirm="確定要刪除群組「<%= group.name %>」嗎？" style="margin-top: var(--space-4);">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn--secondary btn--sm" <%= members.length > 0 ? 'disabled' : '' %>>刪除這個群組</button>
      <% if (members.length > 0) { %><span class="form-hint">（還有成員的群組不能刪除，請先把成員移到其他群組）</span><% } %>
    </form>
  <% } %>
</div>

<%- include('../partials/footer') %>

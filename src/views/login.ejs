<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登入 - <%= siteName %></title>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <div class="login-shell">
    <div class="card login-card">
      <h1><%= siteName %></h1>
      <% if (error) { %>
        <div class="form-error"><%= error %></div>
      <% } %>
      <% if (m365Enabled) { %>
        <div id="m365-login" data-client-id="<%= m365.clientId %>" data-tenant-id="<%= m365.tenantId %>" data-redirect-uri="<%= m365.redirectUri %>" data-csrf="<%= csrfToken %>">
          <button type="button" id="m365-login-btn" class="btn btn--primary btn--lg login-m365-btn" style="width:100%;">使用 Microsoft 365 登入</button>
          <div class="form-error" id="m365-login-error" hidden></div>
        </div>
        <div class="login-divider"><span>或使用帳號密碼</span></div>
      <% } %>
      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="form-label" for="username">帳號</label>
          <input class="form-input" type="text" id="username" name="username" required autofocus>
        </div>
        <div class="form-group">
          <label class="form-label" for="password">密碼</label>
          <input class="form-input" type="password" id="password" name="password" required>
        </div>
        <button type="submit" class="btn <%= m365Enabled ? 'btn--secondary' : 'btn--primary' %> btn--lg" style="width:100%;">登入</button>
      </form>
    </div>
  </div>
<% if (m365Enabled) { %>
  <script src="/vendor/msal-browser.min.js"></script>
  <script src="/js/m365-login.js"></script>
<% } %>
</body>
</html>

<%- include('../layout', { title: '填寫巡檢 - ' + batch.title }) %>

<div class="page-header">
  <h1><%= batch.title %></h1>
  <div class="page-actions">
    <a href="/batches/<%= batch.id %>" class="btn btn--secondary btn--md">查看摘要</a>
    <% if (batch.status === 'draft') { %>
      <form method="POST" action="/batches/<%= batch.id %>/complete" data-confirm="確定要將此批次標記為已完成嗎？完成後仍可查看與產生報告。" style="display:inline;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn--primary btn--md">標記為已完成</button>
      </form>
    <% } %>
  </div>
</div>

<p class="form-hint">巡檢日期：<%= batch.batch_date %><% if (batch.status === 'completed') { %> ・ <strong style="color: var(--color-status-normal);">已完成</strong><% } %></p>

<% assetSections.forEach(section => { %>
  <section class="asset-section">
    <div class="asset-section__header">
      <h2><%= section.asset.name %></h2>
      <span class="form-hint"><%= categoryLabels[section.asset.category] || section.asset.category %><% if (section.asset.location) { %> ・ <%= section.asset.location %><% } %></span>
    </div>

    <% section.rows.forEach(row => { %>
      <div class="checklist-row">
        <div class="checklist-row__title">
          <strong><%= row.checklistItem.label %></strong>
          <% if (row.existing) {
            const st = row.existing.status;
            const stLabel = st === 'normal' ? '正常' : (st === 'warning' ? '警告' : '異常');
          %>
            <span class="status-badge status-badge--<%= st %>"><%= stLabel %></span>
          <% } %>
        </div>
        <form method="POST" action="/batches/<%= batch.id %>/items/<%= row.checklistItem.id %>?_csrf=<%= csrfToken %>" enctype="multipart/form-data">
          <input type="hidden" name="asset_id" value="<%= section.asset.id %>">
          <div class="checklist-row__grid">
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">狀態</label>
              <select class="form-select" name="status" required>
                <% statuses.forEach(s => {
                  const stLabel = s === 'normal' ? '正常' : (s === 'warning' ? '警告' : '異常');
                %>
                  <option value="<%= s %>" <%= row.existing && row.existing.status === s ? 'selected' : '' %>><%= stLabel %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">數值 / 備註內容</label>
              <input class="form-input" type="text" name="value_text" value="<%= row.existing ? (row.existing.value_text || '') : '' %>" placeholder="例如：剩餘 45%">
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label class="form-label">備註</label>
              <input class="form-input" type="text" name="note" value="<%= row.existing ? (row.existing.note || '') : '' %>">
            </div>
            <div>
              <button type="submit" class="btn btn--primary btn--sm">儲存</button>
            </div>
          </div>

          <div class="form-group checklist-row__photos">
            <label class="form-label">截圖（可多選）</label>
            <input class="form-input" type="file" name="screenshots" multiple accept="image/jpeg,image/png,image/webp,image/gif">
            <% if (row.photos && row.photos.length > 0) { %>
              <div class="photo-thumb-list">
                <% row.photos.forEach((photo, pi) => { %>
                  <div class="photo-thumb-list__item">
                    <a href="/uploads/<%= batch.id %>/<%= photo.filename %>" data-viewer="viewer-<%= row.existing.id %>" data-label="<%= section.asset.name %>・<%= row.checklistItem.label %>・截圖 <%= pi + 1 %>" title="點一下就地放大檢視">
                      <img class="screenshot-thumb" src="/uploads/<%= batch.id %>/<%= photo.filename %>" alt="已上傳截圖">
                    </a>
                    <button type="submit" form="photo-delete-<%= photo.id %>" class="photo-thumb-list__delete" title="刪除這張截圖">刪除</button>
                  </div>
                <% }) %>
              </div>
              <div id="viewer-<%= row.existing.id %>" class="photo-viewer-host" data-viewer-host hidden></div>
            <% } %>
          </div>
        </form>
        <%# HTML 不允許 <form> 巢狀，內層的 form 會被瀏覽器直接丟掉，「刪除」按鈕就會變成送出外層的儲存表單。
            所以刪除用的表單放在儲存表單外面，按鈕用 form="..." 屬性指過來。 %>
        <% (row.photos || []).forEach(photo => { %>
          <form id="photo-delete-<%= photo.id %>" method="POST" action="/batches/<%= batch.id %>/photos/<%= photo.id %>/delete" data-confirm="確定要刪除這張截圖嗎？">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          </form>
        <% }) %>
      </div>
    <% }) %>
  </section>
<% }) %>

<section class="asset-section">
  <div class="asset-section__header">
    <h2>新增設備到本次巡檢</h2>
  </div>
  <% if (addAssetError) { %>
    <div class="form-error"><%= addAssetError %></div>
  <% } %>
  <form method="POST" action="/batches/<%= batch.id %>/assets">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label class="form-label">新增設備</label>
      <p class="form-hint">巡檢途中發現漏掉的設備，直接在這裡加進本次批次，不用另外開新批次。</p>
      <div id="new-asset-rows">
        <div class="new-asset-row">
          <input class="form-input" type="text" name="new_asset_name" placeholder="設備名稱，例如：前台PC-01">
          <select class="form-select" name="new_asset_category">
            <% categories.forEach(c => { %>
              <option value="<%= c %>"><%= categoryLabels[c] %></option>
            <% }) %>
          </select>
          <input class="form-input" type="text" name="new_asset_location" placeholder="位置（選填）">
        </div>
      </div>
      <button type="button" id="add-asset-row" class="btn btn--secondary btn--sm">+ 新增一列</button>
    </div>

    <% if (availableAssets && availableAssets.length > 0) { %>
      <div class="form-group">
        <label class="form-label">或從已建立的設備清單勾選</label>
        <div class="checkbox-grid">
          <% availableAssets.forEach(a => { %>
            <label class="checkbox-tile">
              <input type="checkbox" name="asset_ids" value="<%= a.id %>">
              <span><%= a.name %>（<%= categoryLabels[a.category] || a.category %>）</span>
            </label>
          <% }) %>
        </div>
      </div>
    <% } %>

    <button type="submit" class="btn btn--primary btn--md">加入本次巡檢</button>
  </form>
</section>

<script src="/js/asset-quick-add.js"></script>
<script src="/js/photo-viewer.js"></script>

<%- include('../partials/footer') %>

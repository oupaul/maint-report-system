<%- include('../layout', { title: '建立巡檢批次' }) %>

<div class="page-header">
  <h1>建立巡檢批次</h1>
</div>

<div class="card" style="max-width: 720px;">
  <% if (error) { %>
    <div class="form-error"><%= error %></div>
  <% } %>
  <form method="POST" action="/batches/new">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label class="form-label" for="title">批次標題</label>
      <input class="form-input" type="text" id="title" name="title" placeholder="例如：2026年8月例行巡檢" value="<%= formValues ? (formValues.title || '') : '' %>" required>
    </div>
    <div class="form-group">
      <label class="form-label" for="batch_date">巡檢日期</label>
      <input class="form-input" type="date" id="batch_date" name="batch_date" value="<%= formValues ? (formValues.batch_date || '') : '' %>" required>
    </div>
    <div class="form-group">
      <label class="form-label" for="notes">備註</label>
      <textarea class="form-textarea" id="notes" name="notes"><%= formValues ? (formValues.notes || '') : '' %></textarea>
    </div>
    <div class="form-group">
      <label class="form-label">新增本次巡檢設備</label>
      <p class="form-hint">直接輸入設備名稱即可，不用先到「資產管理」建檔；建立後會保留下來，下次巡檢同一台設備時可以直接從清單勾選。</p>
      <div id="new-asset-rows">
        <div class="new-asset-row">
          <input class="form-input" type="text" name="new_asset_name" placeholder="設備名稱，例如：前台PC-01">
          <select class="form-select" name="new_asset_category">
            <% categories.forEach(c => { %>
              <option value="<%= c %>"><%= categoryLabels[c] %></option>
            <% }) %>
          </select>
          <input class="form-input" type="text" name="new_asset_location" placeholder="位置（選填）">
        </div>
      </div>
      <button type="button" id="add-asset-row" class="btn btn--secondary btn--sm">+ 新增一列</button>
    </div>

    <% if (assets.length > 0) { %>
      <div class="form-group">
        <label class="form-label">或從已建立的設備清單勾選</label>
        <div class="checkbox-grid">
          <% assets.forEach(a => { %>
            <label class="checkbox-tile">
              <input type="checkbox" name="asset_ids" value="<%= a.id %>">
              <span><%= a.name %>（<%= categoryLabels[a.category] || a.category %>）</span>
            </label>
          <% }) %>
        </div>
      </div>
    <% } %>
    <button type="submit" class="btn btn--primary btn--md">建立並開始填寫</button>
    <a href="/batches" class="btn btn--secondary btn--md">取消</a>
  </form>
</div>

<script src="/js/asset-quick-add.js"></script>

<%- include('../partials/footer') %>

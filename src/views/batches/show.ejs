<%- include('../layout', { title: batch.title }) %>

<div class="page-header">
  <h1><%= batch.title %></h1>
  <div class="page-actions">
    <% if (!approval.locked) { %>
      <a href="/batches/<%= batch.id %>/entry" class="btn btn--secondary btn--md"><%= batch.status === 'draft' ? '繼續填寫' : '編輯內容' %></a>
    <% } %>
    <a href="/batches/<%= batch.id %>/report.pdf" class="btn btn--primary btn--md" target="_blank">下載 PDF 報告</a>
    <% if (reportGroups.length > 1) { %>
      <details class="report-picker" id="report-picker">
        <summary class="btn btn--secondary btn--md">選擇客戶…</summary>
        <form method="GET" action="/batches/<%= batch.id %>/report.pdf" class="report-picker__panel" id="report-picker-form">
          <p class="form-hint">這個批次涵蓋 <%= reportGroups.length %> 組客戶，勾選要輸出的客戶：</p>
          <% reportGroups.forEach(g => { %>
            <label class="report-picker__item">
              <input type="checkbox" name="customer" value="<%= g.key %>" checked>
              <span><%= g.name %><% if (g.taxId) { %><small class="form-hint">（<%= g.taxId %>）</small><% } %></span>
              <small class="form-hint"><%= g.assetCount %> 台<%= g.abnormal ? `・${g.abnormal} 項異常／警告` : '' %></small>
            </label>
          <% }) %>
          <div class="report-picker__links">
            <button type="button" class="link-button" id="report-pick-all">全選</button>
            <button type="button" class="link-button" id="report-pick-none">全不選</button>
          </div>
          <div class="page-actions">
            <button type="submit" class="btn btn--primary btn--sm" formtarget="_blank" id="report-pdf-btn">下載選取客戶的 PDF</button>
            <button type="submit" class="btn btn--secondary btn--sm" formaction="/batches/<%= batch.id %>/reports.zip" id="report-zip-btn" title="選到的每一家客戶各產生一份 PDF，打包成一個 ZIP">每家客戶各一份（ZIP）</button>
          </div>
          <p class="form-hint">只選部分客戶時，報告封面只列出這些客戶並註明不是完整內容；簽名與簽核紀錄每份都保留。<strong>批次標題與備註會原樣印出</strong>，請確認其中沒有其他客戶的資訊。</p>
        </form>
      </details>
    <% } %>
    <a href="/batches/export/records.csv?batch=<%= batch.id %>" class="btn btn--secondary btn--md" title="把這個批次的每個檢查項目匯出成 CSV">匯出本批次紀錄</a>
  </div>
</div>

<% if (approval.flash) { %><div class="form-success"><%= approval.flash %></div><% } %>
<% if (approval.notice) { %><div class="form-error"><%= approval.notice %></div><% } %>

<p class="form-hint">
  巡檢日期：<%= batch.batch_date %>
  ・狀態：<% if (approval.status.tone === 'draft') { %><%= approval.status.text %><% } else { %><span class="status-badge status-badge--<%= approval.status.tone %>"><%= approval.status.text %></span><% } %>
  <% if (batch.notes) { %>・備註：<%= batch.notes %><% } %>
  <% const custLine = [...new Set(assets.map(a => a.customer_name).filter(Boolean))]; %>
  <% if (custLine.length) { %><br>涵蓋客戶：<strong><%= custLine.join('、') %></strong><%= assets.some(a => !a.customer_name) ? '（另有設備未指定客戶）' : '' %><% } %>
</p>

<% if (approval.show) { %>
<section class="card card--accent">
  <h2>簽核流程</h2>

  <% if (approval.current) { %>
    <p>目前輪到「<strong><%= approval.current.record.stage_label %></strong>」關卡簽核（由 <%= approval.submittedByName || '-' %> 於 <%= (batch.submitted_at || '').slice(0, 16) %> 送出）。</p>
    <% if (approval.current.approverNames.length > 0) { %>
      <p class="form-hint">可以簽核的人：<%= approval.current.approverNames.join('、') %>（管理員也可以處理）</p>
    <% } else { %>
      <p class="form-hint" style="color: var(--color-status-warning);">目前沒有其他可以簽核的人（送審的人不能簽核自己送的批次）。請管理員處理，或請送審的人撤回後調整設定。</p>
    <% } %>
  <% } %>

  <% if (approval.canSubmit) { %>
    <form method="POST" action="/batches/<%= batch.id %>/submit" class="approval-actions" data-confirm="確定要送出審核嗎？送出後這個批次會鎖定，審核通過或被退回前不能編輯。">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group" style="margin:0;">
        <label class="form-label" for="submit-comment">給簽核人的說明（選填）</label>
        <textarea class="form-input" id="submit-comment" name="comment" maxlength="<%= approval.maxComment %>"></textarea>
      </div>
      <div><button type="submit" class="btn btn--primary btn--md">送出審核</button></div>
    </form>
  <% } %>

  <% if (approval.current && approval.current.canAct) { %>
    <form method="POST" action="/batches/<%= batch.id %>/approve" class="approval-actions">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group" style="margin:0;">
        <label class="form-label" for="decision-comment">意見（核准時選填；<strong>退回時必填</strong>）</label>
        <textarea class="form-input" id="decision-comment" name="comment" maxlength="<%= approval.maxComment %>"></textarea>
      </div>
      <div class="page-actions">
        <button type="submit" class="btn btn--primary btn--md">核准「<%= approval.current.record.stage_label %>」</button>
        <button type="submit" formaction="/batches/<%= batch.id %>/return" class="btn btn--secondary btn--md">退回修改</button>
      </div>
    </form>
  <% } %>

  <% if (approval.canWithdraw) { %>
    <form method="POST" action="/batches/<%= batch.id %>/withdraw" data-confirm="確定要撤回審核嗎？批次會解除鎖定，可以重新編輯，之後需要再送出審核。" class="approval-actions">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div><button type="submit" class="btn btn--secondary btn--md">撤回審核</button></div>
    </form>
  <% } %>

  <% if (approval.canReopen) { %>
    <form method="POST" action="/batches/<%= batch.id %>/reopen" data-confirm="確定要重新開啟這個已核准的批次嗎？批次會解除鎖定，修改後需要重新送出審核，這個動作會記錄在簽核紀錄裡。" class="approval-actions">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group" style="margin:0;">
        <label class="form-label" for="reopen-comment">重新開啟的原因（必填）</label>
        <textarea class="form-input" id="reopen-comment" name="comment" maxlength="<%= approval.maxComment %>" required></textarea>
      </div>
      <div><button type="submit" class="btn btn--secondary btn--md">重新開啟</button></div>
    </form>
  <% } %>

  <% if (approval.history.length > 0) { %>
    <h3 style="margin-top: var(--space-6);">簽核紀錄</h3>
    <ul class="approval-timeline">
      <% const multiRound = new Set(approval.history.map(h => h.round)).size > 1; let lastRound = null; %>
      <% approval.history.forEach(h => { %>
        <% if (multiRound && h.round !== lastRound) { lastRound = h.round; %><li class="round-heading">第 <%= h.round %> 輪送審</li><% } %>
        <li class="is-<%= h.kind === 'approved' ? 'approved' : (h.kind === 'returned' || h.kind === 'withdrawn' ? 'returned' : (h.kind === 'waiting' ? 'waiting' : 'other')) %>">
          <strong><%= h.text %></strong>
          <% if (h.who) { %>・<%= h.who %><% } %>
          <% if (h.at) { %><time><%= h.at.slice(0, 16) %></time><% } %>
          <% if (h.comment) { %><span class="comment"><%= h.comment %></span><% } %>
        </li>
      <% }) %>
    </ul>
  <% } else if (!approval.canSubmit) { %>
    <p class="form-hint">還沒有簽核紀錄。</p>
  <% } %>
</section>
<% } %>

<%
  const hasCust = assets.some(a => a.customer_name);
  const custNames = [...new Set(assets.map(a => a.customer_name).filter(Boolean))];
  let lastCust = null;
%>
<% assets.forEach(asset => {
  const items = itemsByAssetId.get(asset.id) || [];
  const custLabel = asset.customer_name || '未指定客戶';
%>
  <% if (hasCust && custLabel !== lastCust) { lastCust = custLabel; %><h2 class="customer-heading">客戶：<%= custLabel %></h2><% } %>
  <section class="asset-section">
    <div class="asset-section__header">
      <h2><%= asset.name %></h2>
      <span class="form-hint"><%= categoryLabels[asset.category] || asset.category %></span>
    </div>
    <% if (items.length === 0) { %>
      <div class="empty-state">此資產尚無檢查紀錄</div>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>檢查項目</th>
              <th>狀態</th>
              <th>數值</th>
              <th>備註</th>
              <th>截圖</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
              <tr id="item-<%= item.id %>">
                <td><%= item.checklist_label %><% if (item.status === 'critical') { %> <a class="form-hint" href="/quotes/new?item=<%= item.id %>" title="把這個異常項目通知業務報價">通知業務報價</a><% } else if (item.status === 'warning') { %> <a class="form-hint" href="/issues/triage?item=<%= item.id %>" title="決定這個警告要持續觀察、排程處理還是報價">處理建議</a><% } %></td>
                <td><span class="status-badge status-badge--<%= item.status %>"><%= item.status === 'normal' ? '正常' : (item.status === 'warning' ? '警告' : '異常') %></span></td>
                <td>
                  <% if (item.volumes && item.volumes.length > 0) { %>
                    <div class="vol-summary">
                      <% item.volumes.forEach(v => { const p = v.total_gb > 0 ? v.used_gb / v.total_gb * 100 : 0; const lvl = p >= 95 ? 'critical' : (p >= 85 ? 'warning' : 'normal'); %>
                        <div class="vol-summary__row">
                          <span class="vol-summary__name"><%= v.name %></span>
                          <span class="vol-bar" role="img" aria-label="<%= v.name %> 使用率 <%= p.toFixed(1) %>%"><span class="vol-bar__fill vol-bar__fill--<%= lvl %>" style="width: <%= Math.min(100, p).toFixed(1) %>%"></span></span>
                          <span class="vol-summary__text"><%= v.used_gb.toLocaleString('en-US', { maximumFractionDigits: 2 }) %> / <%= v.total_gb.toLocaleString('en-US', { maximumFractionDigits: 2 }) %> GB（<%= p.toFixed(1) %>%）</span>
                        </div>
                      <% }) %>
                    </div>
                  <% } else { %><%= item.value_text || '-' %><% } %>
                </td>
                <td><%= item.note || '-' %></td>
                <td>
                  <% if (item.photos && item.photos.length > 0) { %>
                    <% item.photos.forEach((photo, i) => { %><a href="/uploads/<%= batch.id %>/<%= photo.filename %>" data-viewer="viewer-<%= item.id %>" data-label="<%= asset.name %>・<%= item.checklist_label %>・截圖 <%= i + 1 %>">查看<%= item.photos.length > 1 ? (i + 1) : '' %></a><%= i < item.photos.length - 1 ? '　' : '' %><% }) %>
                  <% } else { %>
                    -
                  <% } %>
                </td>
              </tr>
              <% if (item.photos && item.photos.length > 0) { %>
                <tr class="photo-viewer-row" hidden><td colspan="5"><div id="viewer-<%= item.id %>" class="photo-viewer-host" data-viewer-host></div></td></tr>
              <% } %>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
<% }) %>

<section class="asset-section">
  <div class="asset-section__header">
    <h2>簽核</h2>
  </div>
  <div class="signature-grid">
    <% signatureRoles.forEach(role => {
      const sig = signaturesByRole[role];
      // 主管簽核僅限管理員帳號（見 routes/batches.js 的對應檢查），這裡只是
      // 對應的 UI 提示——不要讓非管理員帳號簽完一整筆手寫簽名送出後才被拒絕。
      const canSign = role !== 'supervisor' || (currentUser && currentUser.role === 'admin');
    %>
      <div class="signature-col">
        <h3 class="signature-col__title"><%= signatureRoleLabels[role] %></h3>
        <% if (sig) { %>
          <div class="signature-existing">
            <img class="signature-existing__img" src="/uploads/<%= batch.id %>/<%= sig.filename %>" alt="<%= signatureRoleLabels[role] %>簽名">
            <p class="form-hint"><%= sig.display_name || sig.username %> ・ <%= new Date(sig.signed_at).toLocaleString('zh-TW') %></p>
          </div>
        <% } else { %>
          <p class="form-hint">尚未簽署</p>
        <% } %>

        <% if (canSign) { %>
          <button type="button" class="btn btn--secondary btn--sm signature-open-btn" data-dialog="signature-dialog-<%= role %>">
            <%= sig ? '重新簽署' : '點此簽署' %>
          </button>

          <dialog id="signature-dialog-<%= role %>" class="signature-dialog">
            <% if (savedSignatureVersion) { %>
              <%# 我儲存過的簽名：按「使用這個簽名」才會帶進下面的畫布（不是自動帶入，仍要自己按「確認簽署」）。
                  刪除用獨立的表單（HTML 不允許表單巢狀，所以放在簽名表單外面）。 %>
              <div class="signature-saved">
                <strong class="form-hint">你儲存的簽名</strong>
                <img class="signature-saved__img" src="/account/signature.png?v=<%= encodeURIComponent(savedSignatureVersion) %>" alt="我儲存的簽名">
                <button type="button" class="btn btn--primary btn--sm signature-use-saved" data-src="/account/signature.png?v=<%= encodeURIComponent(savedSignatureVersion) %>">使用這個簽名</button>
                <form method="POST" action="/account/signature/delete" data-confirm="確定要刪除你儲存的預設簽名嗎？（已經簽署的批次不受影響，之後可以重新儲存）">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="return" value="/batches/<%= batch.id %>">
                  <button type="submit" class="btn btn--secondary btn--sm">刪除儲存的簽名</button>
                </form>
              </div>
            <% } %>
            <form class="signature-form" method="POST" action="/batches/<%= batch.id %>/signatures/<%= role %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <h3 class="signature-dialog__title"><%= signatureRoleLabels[role] %>簽名</h3>
              <p class="form-hint">用滑鼠或筆電觸控板按住拖曳書寫，放開即完成這一筆。</p>
              <canvas class="signature-pad" width="500" height="220"></canvas>
              <input type="hidden" class="signature-data-input" name="signature_data">
              <div class="form-group signature-form__type" style="margin-top: var(--space-2); margin-bottom: 0;">
                <label class="form-label">不方便手寫？直接輸入姓名</label>
                <input class="form-input signature-type-input" type="text" placeholder="輸入姓名會自動畫成簽名樣式">
              </div>
              <div class="form-group signature-form__upload" style="margin-top: var(--space-2); margin-bottom: 0;">
                <label class="form-label">或上傳簽名圖檔（例如用 Mac 預覽程式／Word 的觸控板簽名功能簽好後匯出的圖片）</label>
                <input class="form-input signature-file-input" type="file" accept="image/*">
              </div>
              <label class="signature-save-default form-hint">
                <input type="checkbox" name="save_as_default">
                把這個簽名存為我的預設簽名（之後簽名時可以直接選用）
              </label>
              <div class="signature-form__actions">
                <button type="button" class="btn btn--secondary btn--sm signature-clear">清除</button>
                <button type="button" class="btn btn--secondary btn--sm signature-cancel">取消</button>
                <button type="submit" class="btn btn--primary btn--sm">確認簽署</button>
              </div>
            </form>
          </dialog>
        <% } else { %>
          <p class="form-hint">主管簽核僅限管理員帳號</p>
        <% } %>
      </div>
    <% }) %>
  </div>
</section>

<script src="/js/report-picker.js"></script>
<script src="/js/signature-pad.js"></script>
<script src="/js/photo-viewer.js"></script>

<%- include('../partials/footer') %>

<%- include('../layout', { title: '變更密碼' }) %>

<div class="page-header">
  <h1>變更密碼</h1>
</div>

<div class="card" style="max-width: 560px;">
  <% if (currentUser && currentUser.must_change_password) { %>
    <div class="form-error">這個帳號的密碼是系統產生或管理員設定的，請先改成你自己的密碼才能繼續使用系統。</div>
  <% } %>
  <% if (error) { %>
    <div class="form-error"><%= error %></div>
  <% } %>
  <form method="POST" action="/account/password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label class="form-label" for="current_password">目前的密碼</label>
      <input class="form-input" type="password" id="current_password" name="current_password" autocomplete="current-password" required autofocus>
    </div>
    <div class="form-group">
      <label class="form-label" for="new_password">新密碼</label>
      <input class="form-input" type="password" id="new_password" name="new_password" autocomplete="new-password" minlength="<%= minLength %>" required>
      <p class="form-hint">至少 <%= minLength %> 個字元，需同時包含英文字母與數字，不可以是常見密碼或包含帳號名稱。</p>
    </div>
    <div class="form-group">
      <label class="form-label" for="confirm_password">再輸入一次新密碼</label>
      <input class="form-input" type="password" id="confirm_password" name="confirm_password" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn btn--primary btn--md">變更密碼</button>
  </form>
</div>

<%- include('../partials/footer') %>

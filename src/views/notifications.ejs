<%- include('layout', { title: '通知' }) %>

<div class="page-header">
  <h1>通知</h1>
  <div class="page-actions">
    <% if (unreadNotifications > 0) { %>
      <form method="POST" action="/notifications/read-all">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btn btn--secondary btn--md">全部標為已讀</button>
      </form>
    <% } %>
  </div>
</div>

<div class="card">
  <% if (items.length === 0) { %>
    <div class="empty-state">目前沒有通知。巡檢批次送出審核、核准、退回時會通知相關的人。</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>時間（台北時間）</th><th>通知</th><th></th></tr></thead>
        <tbody>
          <% items.forEach(n => { %>
            <tr>
              <td><%= n.created_at.slice(0, 16) %></td>
              <td>
                <% if (!n.is_read) { %><span class="status-badge status-badge--warning">未讀</span> <% } %>
                <strong><%= n.title %></strong>
                <div class="form-hint"><%= n.message %></div>
              </td>
              <td>
                <form method="POST" action="/notifications/<%= n.id %>/open">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn--secondary btn--sm"><%= n.batch_id ? '前往查看' : '標為已讀' %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="form-hint">只顯示最近 50 筆；已讀超過 90 天的通知會自動清除。</p>
  <% } %>
</div>

<%- include('partials/footer') %>

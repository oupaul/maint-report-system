<%- include('layout', { title: '儀表板' }) %>

<div class="page-header">
  <h1>儀表板</h1>
  <div class="page-actions">
    <a href="/batches/new" class="btn btn--primary btn--md">建立新巡檢批次</a>
  </div>
</div>

<div class="stat-row">
  <div class="card stat-card">
    <div class="stat-card__value"><%= batches.length %></div>
    <div class="stat-card__label">近期批次數</div>
  </div>
  <div class="card stat-card">
    <div class="stat-card__value"><%= assetCount %></div>
    <div class="stat-card__label">資產總數</div>
  </div>
</div>

<% if (pendingApprovals.length > 0) { %>
  <div class="card card--accent">
    <h2>待我簽核（<%= pendingApprovals.length %>）</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>批次</th><th>日期</th><th>目前關卡</th><th>送審時間</th><th></th></tr></thead>
        <tbody>
          <% pendingApprovals.forEach(p => { %>
            <tr>
              <td><%= p.batch.title %></td>
              <td><%= p.batch.batch_date %></td>
              <td><%= p.record.stage_label %></td>
              <td><%= (p.batch.submitted_at || '').slice(0, 16) %></td>
              <td><a class="btn btn--primary btn--sm" href="/batches/<%= p.batch.id %>">前往簽核</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<% if (capacityAlerts.length > 0) { %>
  <div class="card">
    <h2>容量預警（<%= capacityAlertTotal %>）</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>設備</th><th>磁碟區</th><th>使用率</th><th>預測</th></tr></thead>
        <tbody>
          <% capacityAlerts.forEach(s => { const p = s.last.pct; const lvl = p >= s.crit_pct ? 'critical' : (p >= s.warn_pct ? 'warning' : 'normal'); %>
            <tr>
              <td><a href="/capacity/assets/<%= s.asset_id %>"><%= s.asset_name %></a></td>
              <td><%= s.volume %></td>
              <td><span class="cap-pct cap-pct--<%= lvl %>"><%= (Math.round(p * 10) / 10).toFixed(1) %>%</span></td>
              <td><small><%= s.text %></small></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p style="margin-top: var(--space-2);"><a href="/capacity">查看全部容量預警<%= capacityAlertTotal > capacityAlerts.length ? '（另有 ' + (capacityAlertTotal - capacityAlerts.length) + ' 個）' : '' %></a></p>
  </div>
<% } %>

<div class="card">
  <h2>近期巡檢批次</h2>
  <% if (batches.length === 0) { %>
    <div class="empty-state">尚無巡檢批次，點擊右上角建立第一筆。</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>標題</th>
            <th>日期</th>
            <th>狀態</th>
            <th>建立者</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% batches.forEach(b => { %>
            <tr>
              <td><%= b.title %></td>
              <td><%= b.batch_date %></td>
              <td>
                <% if (b.status === 'completed') { %>
                  <span class="badge">已完成</span>
                <% } else { %>
                  <span class="badge" style="color: var(--color-primary); border-color: var(--color-primary);">草稿</span>
                <% } %>
              </td>
              <td><%= b.created_by_name || b.created_by_username %></td>
              <td><a href="/batches/<%= b.id %>">查看</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>

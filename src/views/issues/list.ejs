<%- include('../layout', { title: '待處理項目' }) %>

<div class="page-header">
  <h1>待處理項目</h1>
  <div class="page-actions">
    <a href="<%= link().replace('/issues', '/issues/export.csv') %>" class="btn btn--secondary btn--md">匯出 CSV</a>
  </div>
</div>

<% if (flash) { %><div class="form-success"><%= flash %></div><% } %>
<div class="card">
  <p class="form-hint">每台設備的每個檢查項目，只看<strong>最新一次</strong>巡檢的結果，最新一次是<strong>警告或異常</strong>才會列在這裡（舊批次裡已經恢復正常的不會留著）。草稿批次也算。點項目名稱或「查看」會開啟該批次並直接捲到那一列。<strong>警告不一定要報價</strong>：先用「處理建議」決定要持續觀察、排程處理、需要報價，還是已處理；已分流的項目不會再催（複查日期到了、惡化成異常、或標記之後的巡檢仍然異常時，會自動回到「未分流」）。</p>

  <form method="GET" action="/issues" class="asset-filter" id="issue-filter">
    <select class="form-select" name="category" aria-label="依類別篩選">
      <option value="">全部類別</option>
      <% categoryCodes.forEach(c => { %><option value="<%= c %>" <%= f.category === c ? 'selected' : '' %>><%= categoryLabels[c] || c %></option><% }) %>
    </select>
    <select class="form-select" name="location" aria-label="依位置篩選">
      <option value="">全部位置</option>
      <% locations.forEach(l => { %><option value="<%= l %>" <%= f.location === l ? 'selected' : '' %>><%= l %></option><% }) %>
    </select>
    <% if (tags.length > 0) { %>
      <select class="form-select" name="tag" aria-label="依標籤篩選">
        <option value="">全部標籤</option>
        <% tags.forEach(t => { %><option value="<%= t %>" <%= f.tag === t ? 'selected' : '' %>><%= t %></option><% }) %>
      </select>
    <% } %>
    <select class="form-select" name="label" aria-label="依檢查項目篩選">
      <option value="">全部檢查項目</option>
      <% labels.forEach(l => { %><option value="<%= l %>" <%= f.label === l ? 'selected' : '' %>><%= l %></option><% }) %>
    </select>
    <select class="form-select" name="batch" aria-label="依巡檢批次篩選">
      <option value="">全部批次</option>
      <% batches.forEach(b => { %><option value="<%= b.id %>" <%= f.batch === b.id ? 'selected' : '' %>><%= b.date %>　<%= b.title %></option><% }) %>
    </select>
    <% if (quoteEnabled) { %>
      <select class="form-select" name="quote" aria-label="依報價狀態篩選">
        <option value="">不限報價狀態</option>
        <option value="none" <%= f.quote === 'none' ? 'selected' : '' %>>尚未通知業務</option>
        <option value="open" <%= f.quote === 'open' ? 'selected' : '' %>>報價進行中</option>
        <option value="done" <%= f.quote === 'done' ? 'selected' : '' %>>報價已完成</option>
      </select>
    <% } %>
    <select class="form-select" name="triage" aria-label="依處理建議篩選">
      <option value="">不限處理建議</option>
      <option value="none" <%= f.triage === 'none' ? 'selected' : '' %>>未分流（<%= untriaged %>）</option>
      <% Object.keys(DISPOSITIONS).forEach(k => { %><option value="<%= k %>" <%= f.triage === k ? 'selected' : '' %>><%= DISPOSITIONS[k] %></option><% }) %>
    </select>
    <select class="form-select" name="streak" aria-label="連續出現次數">
      <option value="">不限連續次數</option>
      <option value="2" <%= f.minStreak === 2 ? 'selected' : '' %>>連續 2 次以上</option>
      <option value="3" <%= f.minStreak === 3 ? 'selected' : '' %>>連續 3 次以上</option>
    </select>
    <% if (f.severity) { %><input type="hidden" name="severity" value="<%= f.severity %>"><% } %>
    <noscript><button type="submit" class="btn btn--secondary btn--md">套用</button></noscript>
  </form>

  <div class="asset-toolbar">
    <span class="issue-chips">
      <a class="btn btn--sm <%= f.severity === '' ? 'btn--primary' : 'btn--secondary' %>" href="<%= link({ severity: '', page: '' }) %>">全部 <%= counts.critical + counts.warning %></a>
      <a class="btn btn--sm <%= f.severity === 'critical' ? 'btn--primary' : 'btn--secondary' %>" href="<%= link({ severity: 'critical', page: '' }) %>">異常 <%= counts.critical %></a>
      <a class="btn btn--sm <%= f.severity === 'warning' ? 'btn--primary' : 'btn--secondary' %>" href="<%= link({ severity: 'warning', page: '' }) %>">警告 <%= counts.warning %></a>
    </span>
    <span class="form-hint">符合 <%= matched %> / 全部 <%= total %> 筆<%= pages > 1 ? `・第 ${page} / ${pages} 頁` : '' %></span>
  </div>

  <% if (total === 0) { %>
    <div class="empty-state">目前沒有警告或異常的項目 👍</div>
  <% } else if (rows.length === 0) { %>
    <div class="empty-state">沒有符合條件的項目。<a href="/issues">清除篩選</a></div>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table issue-table">
        <thead>
          <tr><th>嚴重度</th><th>設備 / 位置</th><th>檢查項目</th><th>數值 / 備註</th><th>最新巡檢</th><th>處理建議<%= quoteEnabled ? ' / 報價' : '' %></th></tr>
        </thead>
        <tbody>
          <% rows.forEach(r => { %>
            <tr>
              <td>
                <span class="status-badge status-badge--<%= r.status %>"><%= r.status === 'critical' ? '異常' : '警告' %></span><br>
                <small class="form-hint"><%= r.streak >= 2 ? `連續 ${r.streak} 次` : '首次' %></small>
              </td>
              <td><strong><%= r.asset_name %></strong><br><small class="form-hint"><%= categoryLabels[r.category] || r.category %><%= r.location ? '・' + r.location : '' %></small></td>
              <td>
                <a href="/batches/<%= r.batch_id %>#item-<%= r.item_id %>"><strong><%= r.label %></strong></a>
                <div class="issue-actions">
                  <a href="/batches/<%= r.batch_id %>#item-<%= r.item_id %>">查看</a>
                  <% if (r.batchInfo.editable) { %><a href="/batches/<%= r.batch_id %>/entry#row-a<%= r.asset_id %>-c<%= r.checklist_item_id %>">前往填寫</a><% } %>
                  <% if (r.volumes && r.volumes.length > 0) { %><a href="/capacity/assets/<%= r.asset_id %>">容量趨勢</a><% } %>
                </div>
              </td>
              <td>
                <% if (r.display) { %><div class="issue-value"><%= r.display %></div><% } %>
                <% if (r.note) { %><div class="form-hint">備註：<%= r.note %></div><% } %>
                <% if (!r.display && !r.note) { %>-<% } %>
              </td>
              <td>
                <%= r.batch_date %><br>
                <small class="form-hint"><a href="/batches/<%= r.batch_id %>"><%= r.batch_title %></a>
                  <span class="status-badge status-badge--<%= r.batchInfo.tone === 'draft' ? 'warning' : r.batchInfo.tone %>"><%= r.batchInfo.text %></span></small>
              </td>
              <td class="triage-cell">
                <% if (r.triage) { %>
                  <span class="status-badge triage-badge triage-badge--<%= r.triage.disposition %>"><%= DISPOSITIONS[r.triage.disposition] %><%= r.triage.review_date ? '・' + r.triage.review_date : '' %></span>
                  <% if (r.triage.note) { %><div class="form-hint"><%= r.triage.note %></div><% } %>
                  <div class="form-hint"><%= r.triage.updated_by_name %>・<%= (r.triage.updated_at || '').slice(0, 10) %>　<a href="/issues/triage?item=<%= r.item_id %>">修改</a></div>
                <% } else { %>
                  <span class="status-badge status-badge--warning">未分流</span>
                  <% if (r.resurfaced) { %><div class="import-warn"><%= r.resurfaced %></div><% } %>
                  <div class="hint-line hint-line--<%= r.hint.tone %>">建議：<%= r.hint.text %></div>
                  <a class="btn btn--secondary btn--sm" href="/issues/triage?item=<%= r.item_id %>">處理建議</a>
                <% } %>
                <% if (quoteEnabled) { %>
                  <div class="quote-line">
                <% if (r.quote) { %>
                    <a href="/quotes/<%= r.quote.id %>"><span class="status-badge <%= ['quoted'].includes(r.quote.status) ? 'status-badge--normal' : (['closed'].includes(r.quote.status) ? '' : 'status-badge--warning') %>">Q-<%= r.quote.id %> <%= STATUS[r.quote.status] %></span></a>
                  <% } else if (r.canQuote) { %>
                    <a class="btn btn--secondary btn--sm" href="/quotes/new?item=<%= r.item_id %>">通知業務報價</a>
                  <% } else { %>
                    <span class="form-hint">警告：先選處理建議</span>
                  <% } %>
                  </div>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (pages > 1) { %>
      <nav class="pager" aria-label="分頁">
        <% if (page > 1) { %><a class="btn btn--secondary btn--sm" href="<%= link({ page: page - 1 }) %>">上一頁</a><% } %>
        <span class="form-hint">第 <%= page %> / <%= pages %> 頁</span>
        <% if (page < pages) { %><a class="btn btn--secondary btn--sm" href="<%= link({ page: page + 1 }) %>">下一頁</a><% } %>
      </nav>
    <% } %>
  <% } %>
</div>

<script src="/js/issue-filter.js"></script>
<%- include('../partials/footer') %>

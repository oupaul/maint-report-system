# 本專案未使用 dotenv，需自行 export 這些變數，或透過 deploy.sh 產生的 systemd unit 設定。
# npm run dev / node src/app.js 時，未設定的變數會使用下方註解的開發用預設值。

# 服務埠號（預設 3000）
PORT=3000

# development | production（deploy.sh 部署時固定寫入 production）
NODE_ENV=development

# Session 簽章金鑰。正式部署由 deploy.sh 以 `openssl rand -hex 32` 自動產生，存放於 /etc/maint-report-system/session.env（權限 600）。
# 本機開發若未設定，src/config/index.js 會自動產生一組隨機值（每次重啟都會讓所有人被登出，僅供開發使用）。
SESSION_SECRET=

# 前面有反向代理（nginx/Caddy 等）時才設定，例如 1 代表信任一層代理，讓系統取得真實用戶 IP。
# 直接以 IP:port 存取請保持空白——否則登入限流可被偽造的 X-Forwarded-For 繞過。
TRUST_PROXY=

# 全新安裝時管理員（admin）的初始密碼。不設定就由系統產生亂數密碼並印在終端機（建議）。
INITIAL_ADMIN_PASSWORD=

# M365（Azure AD / Entra ID）SSO 登入，選用功能：下面三個都設定了才會（不需要 Client Secret，Azure 端登錄為 SPA）在登入頁
# 顯示「使用 Microsoft 365 登入」按鈕，沒設定的話系統照常只用帳號密碼登入，
# 不會出錯。設定步驟見 README.md「Microsoft 365 SSO」一節。
# 使用者仍須先由管理員在「使用者管理」建立帳號並填入 M365 Email 才能用 SSO 登入。
M365_CLIENT_ID=
M365_TENANT_ID=
M365_REDIRECT_URI=https://your-domain/auth/m365/callback   # 必須是 https（或 http://localhost），且與 Azure SPA 登錄的完全一致
